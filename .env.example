# Copy to .env.local

# Secret used to seal round tokens and the Spotify session cookie (any long random string).
APP_SECRET=change-me-to-a-long-random-string

# Spotify app credentials — https://developer.spotify.com/dashboard
# Redirect URI to register in the dashboard (Spotify no longer accepts "localhost"):
#   http://127.0.0.1:3000/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional override; defaults to <origin>/api/spotify/callback
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
